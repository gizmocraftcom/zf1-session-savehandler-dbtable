{
    "name": "gizmocraft/zendframework1-session-savehandler-dbtable",
    "description": "Zend Framework 1 Session_SaveHandler_DbTable component",
    "type": "library",
    "keywords": [
        "framework",
        "zf1"
    ],
    "homepage": "http://framework.zend.com/",
    "license": "BSD-3-Clause",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-config"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-exception"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-json"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-xml"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-server"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-session"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-loader"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-db"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-registry"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-cache"
        },
        {
            "type": "vcs",
            "url": "https://github.com/gizmocraftcom/zf1-log"
        }
    ],
    "require": {
        "ext-session": "*",
        "php": ">=8.5",
        "gizmocraft/zendframework1-config": "^3.0.0",
        "gizmocraft/zendframework1-session": "^3.0.0",
        "gizmocraft/zendframework1-db": "^2.0.0"
    },
    "autoload": {
        "classmap": [
            "src/Zend/Session/SaveHandler/DbTable.php"
        ]
    },
    "autoload-dev": {
        "psr-0": {
            "Zend_": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.8",
        "phpstan/phpstan": "^2.3.7",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpro/grumphp-shim": "^2.27.2"
    },
    "archive": {
        "exclude": [
            "/tests"
        ]
    },
    "scripts": {
        "test": "phpunit ./tests",
        "test-with-coverage": "phpunit --coverage-clover=clover.xml",
        "phpstan": "phpstan analyze -c phpstan.neon --no-progress --ansi --memory-limit=768M",
        "style-check": "php-cs-fixer fix --dry-run -vv"
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp-shim": true
        }
    }
}
